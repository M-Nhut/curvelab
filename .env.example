# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO VERCEL VÀ SUPABASE
# Sao chép các biến này vào phần "Environment Variables" trên Vercel Project Settings
# ==============================================================================

# URL kết nối tới dự án Supabase của bạn (Lấy trong Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Public Anon Key (Dùng an toàn ở phía client/trình duyệt)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Tên Storage Bucket lưu trữ file và ảnh xuất của CurveLab
SUPABASE_STORAGE_BUCKET=curvelab-files
