{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/CurveLab/index.html"
    },
    {
      "source": "/construction",
      "destination": "/CurveLab/construction.html"
    },
    {
      "source": "/studio",
      "destination": "/CurveLab/studio.html"
    },
    {
      "source": "/CurveLab/:match*",
      "destination": "/CurveLab/:match*"
    },
    {
      "source": "/:match*",
      "destination": "/CurveLab/:match*"
    }
  ]
}
