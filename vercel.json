{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "CurveLab",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/CurveLab",
      "destination": "/"
    },
    {
      "source": "/CurveLab/:path*",
      "destination": "/:path*"
    }
  ]
}
